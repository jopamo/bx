/*
 * name, getopt argument mode, value, short grammar fragment, compatibility
 * alias, help metavar, description, category, implemented by this frontend.
 */
MIRA_OPTION("version", no_argument, 'V', "V", NULL, NULL, "display version information", MIRA_OPTION_CATEGORY_STARTUP, true)
MIRA_OPTION("help", no_argument, 'h', "h", NULL, NULL, "display this help", MIRA_OPTION_CATEGORY_STARTUP, true)
MIRA_OPTION("quiet", no_argument, 'q', "q", NULL, NULL, "suppress normal status output", MIRA_OPTION_CATEGORY_STARTUP, true)
MIRA_OPTION("verbose", no_argument, 'v', "v", NULL, NULL, "enable verbose status output", MIRA_OPTION_CATEGORY_STARTUP, true)
MIRA_OPTION("no-verbose", no_argument, MIRA_OPT_NO_VERBOSE, "", "-nv", NULL, "disable verbose status output", MIRA_OPTION_CATEGORY_STARTUP, true)
MIRA_OPTION("output-file", required_argument, MIRA_OPT_OUTPUT_FILE, "", NULL, "FILE", "log messages to FILE", MIRA_OPTION_CATEGORY_UNSUPPORTED, false)
MIRA_OPTION("append-output", required_argument, MIRA_OPT_APPEND_OUTPUT, "", NULL, "FILE", "append log messages to FILE", MIRA_OPTION_CATEGORY_UNSUPPORTED, false)
MIRA_OPTION("debug", no_argument, MIRA_OPT_DEBUG, "", NULL, NULL, "emit structured trace events", MIRA_OPTION_CATEGORY_UNSUPPORTED, false)
MIRA_OPTION("input-file", required_argument, MIRA_OPT_INPUT_FILE, "", NULL, "FILE", "read URL input from FILE", MIRA_OPTION_CATEGORY_UNSUPPORTED, false)
MIRA_OPTION("force-html", no_argument, MIRA_OPT_FORCE_HTML, "", NULL, NULL, "treat input file as HTML", MIRA_OPTION_CATEGORY_UNSUPPORTED, false)
MIRA_OPTION("base", required_argument, MIRA_OPT_BASE, "", NULL, "URL", "set the input-file base URL", MIRA_OPTION_CATEGORY_UNSUPPORTED, false)
MIRA_OPTION("rejected-log", required_argument, MIRA_OPT_REJECTED_LOG, "", NULL, "FILE", "log rejected URLs to FILE", MIRA_OPTION_CATEGORY_UNSUPPORTED, false)

MIRA_OPTION("tries", required_argument, 't', "t:", NULL, "NUMBER", "bound transfer attempts", MIRA_OPTION_CATEGORY_DOWNLOAD, true)
MIRA_OPTION("retry-connrefused", no_argument, MIRA_OPT_RETRY_CONNREFUSED, "", NULL, NULL, "retry connection-refused failures", MIRA_OPTION_CATEGORY_DOWNLOAD, true)
MIRA_OPTION("retry-on-http-error", required_argument, MIRA_OPT_RETRY_ON_HTTP_ERROR, "", NULL, "CODES", "retry comma-separated HTTP statuses", MIRA_OPTION_CATEGORY_DOWNLOAD, true)
MIRA_OPTION("output-document", required_argument, 'O', "O:", NULL, "FILE", "write one document to FILE", MIRA_OPTION_CATEGORY_DOWNLOAD, true)
MIRA_OPTION("no-clobber", no_argument, MIRA_OPT_NO_CLOBBER, "", "-nc", NULL, "skip existing output files", MIRA_OPTION_CATEGORY_UNSUPPORTED, false)
MIRA_OPTION("continue", no_argument, 'c', "c", NULL, NULL, "resume partial downloads", MIRA_OPTION_CATEGORY_DOWNLOAD, true)
MIRA_OPTION("progress", required_argument, MIRA_OPT_PROGRESS, "", NULL, "bar|none", "select progress rendering", MIRA_OPTION_CATEGORY_DOWNLOAD, true)
MIRA_OPTION("show-progress", no_argument, MIRA_OPT_SHOW_PROGRESS, "", NULL, NULL, "enable progress rendering", MIRA_OPTION_CATEGORY_DOWNLOAD, true)
MIRA_OPTION("timestamping", no_argument, 'N', "N", NULL, NULL, "retrieve only newer documents", MIRA_OPTION_CATEGORY_DOWNLOAD, true)
MIRA_OPTION("no-if-modified-since", no_argument, MIRA_OPT_NO_IF_MODIFIED_SINCE, "", NULL, NULL, "disable If-Modified-Since", MIRA_OPTION_CATEGORY_DOWNLOAD, true)
MIRA_OPTION("no-use-server-timestamps", no_argument, MIRA_OPT_NO_USE_SERVER_TIMESTAMPS, "", NULL, NULL, "keep local commit timestamps", MIRA_OPTION_CATEGORY_DOWNLOAD, true)
MIRA_OPTION("server-response", no_argument, 'S', "S", NULL, NULL, "print bounded response headers", MIRA_OPTION_CATEGORY_DOWNLOAD, true)
MIRA_OPTION("spider", no_argument, MIRA_OPT_SPIDER, "", NULL, NULL, "check URLs without saving bodies", MIRA_OPTION_CATEGORY_DOWNLOAD, true)
